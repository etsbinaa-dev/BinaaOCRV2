<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        الصلاحيات: POST_NOTIFICATIONS (رقم الدفعات على الأيقونة) وINTERNET للمزامنة بين هاتفي المستخدم فقط.
        - INTERNET: المزامنة المشفّرة مع مجلد التطبيق الخاص في Google Drive (sync/). القراءة نفسها (Tesseract وML Kit)
          تجري على الهاتف ولا تتصل بشيء.
        - لا ACCESS_NETWORK_STATE، ولا READ_MEDIA_IMAGES ولا READ_EXTERNAL_STORAGE ولا الكاميرا ولا منتقي صور: المدخل الوحيد
          لقطة شاشة تُشارَك من WhatsApp، وتصل عبر URI بإذن قراءة مؤقت للصورة وحدها. رمز الربط يُمسح بماسح Google.
        CI يرفض أي APK إصدار تظهر فيه صلاحية غير هذه (حتى لو أضافتها مكتبة).
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <!-- إشعار صامت واحد بعدد الدفعات «للإدخال»: هو ما يُظهر الرقم على أيقونة التطبيق. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        أيقونات تطبيقات الدفع المثبّتة على الهاتف (Bankily، Sedad…) تُعرض على بطاقات الدفعات: يكفي أن يرى التطبيق
        قائمة الأيقونات في الشاشة الرئيسية. ليست صلاحية، ولا شعارات تجارية داخل التطبيق.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".BinaaApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BinaaOcr">

        <!--
            مكوّن telemetry من Google (datatransport) يأتي مع ML Kit ويرسل إحصاءات استعمال. التطبيق صار يملك INTERNET
            للمزامنة، فنزيل مكوّناته: بلا TransportBackendDiscovery لا توجد جهة يُرسَل إليها شيء. CI يتحقق من غيابها.
        -->
        <service android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery" tools:node="remove" />
        <service android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService" tools:node="remove" />
        <receiver android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.AlarmManagerSchedulerBroadcastReceiver" tools:node="remove" />

        <!-- الشاشة الرئيسية: متابعة وإرشاد فقط. لا تبدأ منها أي قراءة. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            المدخل الوحيد: مشاركة صورة من WhatsApp.
            SEND_MULTIPLE مسجَّل فقط لنعرض رسالة «شارك صورة واحدة فقط في كل مرة» بدل أن يختفي التطبيق
            من قائمة المشاركة؛ لا تُعالج أي صورة من مشاركة متعددة.
            singleTask + taskAffinity خاص: نسخة واحدة فقط، فتصل المشاركة الجديدة إليها (onNewIntent).
        -->
        <activity
            android:name=".intake.IntakeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.binaa.ocr.intake"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

    </application>

</manifest>
